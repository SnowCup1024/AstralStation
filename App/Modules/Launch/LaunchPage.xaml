<UserControl x:Class="AstralStation.Modules.Launch.LaunchPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="24,16,24,16" RowSpacing="12" AllowDrop="True" DragOver="FilesOver" Drop="FilesDrop">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="4"><TextBlock Text="启动管理" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="安排启动，留存每一次游玩的记录。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
   <Button Grid.Column="1" Content="添加任务" Click="AddTask" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"/>
  </Grid>
  <InfoBar Grid.Row="1" x:Name="ErrorBar" IsClosable="False" Severity="Error"/>
  <Pivot Grid.Row="2" x:Name="Tabs" SelectionChanged="TabChanged">
   <PivotItem AutomationProperties.Name="今日队列"><PivotItem.Header><TextBlock Text="今日队列" FontSize="16"/></PivotItem.Header>
    <Grid RowSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource SectionCard}">
      <StackPanel Spacing="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Summary" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="QueueHint" FontSize="12"/></StackPanel><Button Grid.Column="1" x:Name="PauseButton" Click="Pause" Content="暂停自动队列"/></Grid><ProgressBar x:Name="Progress" Maximum="100"/></StackPanel>
     </Border>
     <Grid Grid.Row="1"><ListView x:Name="QueueList" SelectionMode="Single" KeyDown="TaskKey" DoubleTapped="DoubleRun" RightTapped="TaskMenu" HorizontalContentAlignment="Stretch" SelectionChanged="SelectionChanged">
      <ListView.ItemTemplate><DataTemplate><Grid Padding="8,10" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Width="32" Height="32" Loaded="IconLoaded"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" FontSize="12"/><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><Button Grid.Column="2" Content="启动" Tag="{Binding Id}" Click="RowRun" VerticalAlignment="Center"/></Grid></DataTemplate></ListView.ItemTemplate>
     </ListView><TextBlock x:Name="EmptyQueue" Text="还没有任务。添加一个游戏或脚本，开始安排今日队列。" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340"/></Grid>
     <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button x:Name="RunButton" Content="启动所选" Click="RunSelected"/><Button x:Name="RetryButton" Content="重试所选" Click="RetrySelected"/><Button Content="重置全部进度" Click="ResetAll"/></StackPanel>
     <Expander Grid.Row="3" Header="最近 24 小时活动" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><ScrollViewer MaxHeight="140"><TextBlock x:Name="ActivityText" FontSize="12" IsTextSelectionEnabled="True"/></ScrollViewer></Expander>
    </Grid>
   </PivotItem>
   <PivotItem AutomationProperties.Name="任务库"><PivotItem.Header><TextBlock Text="任务库" FontSize="16"/></PivotItem.Header>
    <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="拖动任务调整自动启动顺序；右键可管理完成状态和启动选项。" VerticalAlignment="Center"/><Button Grid.Column="1" Content="检测已安装游戏" Click="DetectGames"/></Grid>
     <ListView Grid.Row="1" x:Name="LibraryList" CanReorderItems="True" CanDragItems="True" AllowDrop="True" DragItemsStarting="ReorderStarting" DragItemsCompleted="Reordered" SelectionMode="Single" HorizontalContentAlignment="Stretch" KeyDown="TaskKey" DoubleTapped="DoubleEdit" RightTapped="TaskMenu">
      <ListView.ItemTemplate><DataTemplate><Grid Padding="8,12" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⠿" VerticalAlignment="Center"/><Image Grid.Column="1" Width="32" Height="32" Loaded="IconLoaded"/><StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1"/><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
     </ListView>
     <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="编辑" Click="EditSelected"/><Button Content="启动选项" Click="OptionsSelected"/><Button Content="复制" Click="DuplicateSelected"/><Button Content="启用 / 停用" Click="ToggleSelected"/><Button Content="上移" Click="MoveUp"/><Button Content="下移" Click="MoveDown"/><Button Content="删除" Click="DeleteSelected"/></StackPanel></ScrollViewer>
    </Grid>
   </PivotItem>
   <PivotItem AutomationProperties.Name="运行日历"><PivotItem.Header><TextBlock Text="运行日历" FontSize="16"/></PivotItem.Header><ContentControl x:Name="CalendarHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></PivotItem>
   <PivotItem AutomationProperties.Name="模块设置"><PivotItem.Header><TextBlock Text="模块设置" FontSize="16"/></PivotItem.Header><ScrollViewer><StackPanel Spacing="16" MaxWidth="680" HorizontalAlignment="Left">
    <Border Style="{StaticResource SectionCard}"><StackPanel Spacing="12"><TextBlock Text="完成之后" Style="{StaticResource SectionTitleStyle}"/><ToggleSwitch x:Name="AutoClose" Header="全部任务完成并退出后关闭星间驿站" OnContent="倒计时 15 秒后退出" OffContent="保持打开" Toggled="SettingsChanged"/><TextBlock Text="只有停留在今日队列时才会自动退出。记录保存失败或还有运行任务时不会退出。" FontSize="12"/></StackPanel></Border>
    <Border Style="{StaticResource SectionCard}"><StackPanel Spacing="12"><TextBlock Text="窗口与启动" Style="{StaticResource SectionTitleStyle}"/><ToggleSwitch x:Name="Tray" Header="允许托盘后台运行" OnContent="最小化时收入托盘" OffContent="关闭" Toggled="SettingsChanged"/><ToggleSwitch x:Name="CloseToTray" Header="关闭窗口时保留到托盘" OnContent="已开启" OffContent="直接退出" Toggled="SettingsChanged"/><ToggleSwitch x:Name="Login" Header="Windows 登录时启动" OnContent="已开启" OffContent="关闭" Toggled="LoginChanged"/></StackPanel></Border>
    <Border Style="{StaticResource SectionCard}"><StackPanel Spacing="12"><TextBlock Text="本地数据" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="DataPath" IsTextSelectionEnabled="True"/><Button Content="打开数据目录" Click="OpenData"/><TextBlock Text="任务、状态和历史以 JSON 保存，并保留 .bak 备份。退出应用不会关闭游戏。" FontSize="12"/></StackPanel></Border>
   </StackPanel></ScrollViewer></PivotItem>
  </Pivot>
 </Grid>
</UserControl>
