<UserControl x:Class="AstralStation.Modules.Launch.LaunchPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:launch="using:AstralStation.Modules.Launch"
 xmlns:services="using:AstralStation.Services">
 <Grid Margin="24,16,24,16" RowSpacing="0" AllowDrop="True" DragOver="FilesOver" Drop="FilesDrop">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="12" Padding="0,0,0,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="启动管理" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
   <Button Grid.Column="1" Content="添加任务" Click="AddTask" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"/>
  </Grid>
  <InfoBar Grid.Row="1" x:Name="ErrorBar" IsClosable="False" Severity="Error"/>
  <Pivot Grid.Row="2" x:Name="Tabs" SelectionChanged="TabChanged">
   <PivotItem Margin="0" AutomationProperties.Name="今日队列"><PivotItem.Header><TextBlock Text="今日队列" FontSize="16"/></PivotItem.Header>
    <Grid RowSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource SectionCard}">
      <Grid x:Name="QueueLayout" ColumnSpacing="20" RowSpacing="16" SizeChanged="QueueSizeChanged">
       <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
       <StackPanel x:Name="RingPanel" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid Width="224" Height="224">
         <services:CompletionRing x:Name="Progress"/>
         <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="170">
          <TextBlock x:Name="RingLabel" TextAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
          <TextBlock x:Name="RingValue" FontSize="30" FontWeight="SemiBold" TextAlignment="Center"/>
          <TextBlock x:Name="RingTask" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2"/>
         </StackPanel>
        </Grid>
        <TextBlock x:Name="Summary" TextAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Button x:Name="PauseButton" Click="Pause" Content="暂停自动队列" HorizontalAlignment="Center"/>
       </StackPanel>
       <Grid x:Name="QueueContent" Grid.Column="1"><ListView x:Name="QueueList" SelectionMode="Single" KeyDown="TaskKey" DoubleTapped="DoubleRun" RightTapped="TaskMenu" HorizontalContentAlignment="Stretch" SelectionChanged="SelectionChanged">
      <ListView.ItemTemplate><DataTemplate x:DataType="launch:LaunchTask"><Grid Padding="8,10" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><services:GameIcon Width="60" Height="60" Loaded="IconLoaded" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><services:PathLabel Text="{Binding Path}"/><TextBlock Text="{x:Bind Completion, Mode=OneWay}" FontSize="12" TextWrapping="NoWrap"/></StackPanel><TextBlock Grid.Column="2" Text="{x:Bind Status, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" MaxWidth="160" FontSize="13"/></Grid></DataTemplate></ListView.ItemTemplate>
     </ListView><TextBlock x:Name="EmptyQueue" Text="还没有任务。添加一个游戏或脚本，开始安排今日队列。" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340"/></Grid></Grid></Border>
     <Border x:Name="QueueActions" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource SectionCard}" Padding="12"><ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="RunButton" Content="启动此任务" Click="RunSelected" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="RetryButton" Content="重试此任务" Click="RetrySelected"/><Button Content="此任务标注为完成" Click="MarkSelected"/><Button Content="重置全部任务进度" Click="ResetAll"/></StackPanel></ScrollViewer></Border>
    </Grid>
   </PivotItem>
   <PivotItem Margin="0" AutomationProperties.Name="任务库"><PivotItem.Header><TextBlock Text="任务库" FontSize="16"/></PivotItem.Header>
    <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Grid.Row="0" Style="{StaticResource SectionCard}" Padding="8"><ListView x:Name="LibraryList" CanReorderItems="True" CanDragItems="True" AllowDrop="True" DragItemsStarting="ReorderStarting" DragItemsCompleted="Reordered" SelectionMode="Single" HorizontalContentAlignment="Stretch" KeyDown="TaskKey" DoubleTapped="DoubleEdit" RightTapped="TaskMenu" SelectionChanged="SelectionChanged">
      <ListView.ItemTemplate><DataTemplate x:DataType="launch:LaunchTask"><Grid Padding="8,12" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⠿" VerticalAlignment="Center"/><services:GameIcon Grid.Column="1" Width="60" Height="60" Loaded="IconLoaded" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><services:PathLabel Text="{Binding Path}"/><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
     </ListView></Border><Border x:Name="LibraryActions" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource SectionCard}" Padding="12">
 <StackPanel Orientation="Horizontal" Spacing="10">
  <Button Style="{StaticResource IconAction}" Click="EditSelected" ToolTipService.ToolTip="编辑任务（F2）" AutomationProperties.Name="编辑任务"><FontIcon Glyph="&#xE70F;" FontSize="18"/></Button>
  <Button Style="{StaticResource IconAction}" Click="OptionsSelected" ToolTipService.ToolTip="启动选项（Ctrl+E）" AutomationProperties.Name="启动选项"><FontIcon Glyph="&#xE713;" FontSize="18"/></Button>
  <Button Style="{StaticResource IconAction}" Click="DuplicateSelected" ToolTipService.ToolTip="复制任务（Ctrl+D）" AutomationProperties.Name="复制任务"><FontIcon Glyph="&#xE8C8;" FontSize="18"/></Button>
  <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,6"/>
  <Button Style="{StaticResource IconAction}" Click="MoveUp" ToolTipService.ToolTip="上移（Ctrl+↑）" AutomationProperties.Name="上移任务"><FontIcon Glyph="&#xE74A;" FontSize="18"/></Button>
  <Button Style="{StaticResource IconAction}" Click="MoveDown" ToolTipService.ToolTip="下移（Ctrl+↓）" AutomationProperties.Name="下移任务"><FontIcon Glyph="&#xE74B;" FontSize="18"/></Button>
  <Button Style="{StaticResource IconAction}" Click="DeleteSelected" ToolTipService.ToolTip="删除任务（Delete）" AutomationProperties.Name="删除任务"><FontIcon Glyph="&#xE74D;" FontSize="18"/></Button>
 </StackPanel>
</Border>
    </Grid>
   </PivotItem>
   <PivotItem Margin="0" AutomationProperties.Name="运行日历"><PivotItem.Header><TextBlock Text="运行日历" FontSize="16"/></PivotItem.Header><ContentControl x:Name="CalendarHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></PivotItem>
   <PivotItem Margin="0" AutomationProperties.Name="模块设置"><PivotItem.Header><TextBlock Text="模块设置" FontSize="16"/></PivotItem.Header><ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,8,0">
    <Border Style="{StaticResource SectionCard}"><StackPanel Spacing="12"><TextBlock Text="完成之后" Style="{StaticResource SectionTitleStyle}"/><Border Style="{StaticResource SectionCard}" Padding="14"><Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="全部任务完成并退出后关闭星间驿站" VerticalAlignment="Center" TextWrapping="Wrap"/><ComboBox Grid.Column="1" x:Name="AutoClose" AutomationProperties.Name="全部任务完成并退出后关闭星间驿站" Width="200" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="SettingsChanged"><ComboBoxItem Content="保持打开"/><ComboBoxItem Content="倒计时 15 秒后退出"/></ComboBox></Grid></Border><TextBlock Text="只有停留在今日队列时才会自动退出。记录保存失败或还有运行任务时不会退出。" FontSize="12"/></StackPanel></Border>
    <Border Style="{StaticResource SectionCard}"><StackPanel Spacing="12"><TextBlock Text="窗口与启动" Style="{StaticResource SectionTitleStyle}"/><Border Style="{StaticResource SectionCard}" Padding="14"><Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="允许托盘后台运行" VerticalAlignment="Center" TextWrapping="Wrap"/><ComboBox Grid.Column="1" x:Name="Tray" AutomationProperties.Name="允许托盘后台运行" Width="200" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="SettingsChanged"><ComboBoxItem Content="关闭"/><ComboBoxItem Content="最小化时收入托盘"/></ComboBox></Grid></Border><Border Style="{StaticResource SectionCard}" Padding="14"><Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="关闭窗口时保留到托盘" VerticalAlignment="Center" TextWrapping="Wrap"/><ComboBox Grid.Column="1" x:Name="CloseToTray" AutomationProperties.Name="关闭窗口时保留到托盘" Width="200" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="SettingsChanged"><ComboBoxItem Content="直接退出"/><ComboBoxItem Content="已开启"/></ComboBox></Grid></Border><Border Style="{StaticResource SectionCard}" Padding="14"><Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Windows 登录时启动" VerticalAlignment="Center" TextWrapping="Wrap"/><ComboBox Grid.Column="1" x:Name="Login" AutomationProperties.Name="Windows 登录时启动" Width="200" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="LoginChanged"><ComboBoxItem Content="关闭"/><ComboBoxItem Content="已开启"/></ComboBox></Grid></Border></StackPanel></Border>
    <Border Style="{StaticResource SectionCard}"><StackPanel Spacing="12"><TextBlock Text="本地数据" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="DataPath" IsTextSelectionEnabled="True"/><Button Content="打开数据目录" Click="OpenData"/><TextBlock Text="任务、状态和历史以 JSON 保存，并保留 .bak 备份。退出应用不会关闭游戏。" FontSize="12"/></StackPanel></Border>
   </StackPanel></ScrollViewer></PivotItem>
  </Pivot>
 </Grid>
</UserControl>
