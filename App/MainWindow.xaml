<Window x:Class="AstralStation.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="星间驿站">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Background="Transparent">
   <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,140,0" VerticalAlignment="Center">
    <Image Source="ms-appx:///Assets/App.png" Width="24" Height="24"/>
    <TextBlock Text="星间驿站" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Text="Alpha 1.0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontSize="12"/>
   </StackPanel>
  </Grid>
  <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="208"
   IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="Navigate">
   <NavigationView.MenuItems>
    <NavigationViewItemHeader Content="我的工具"/>
    <NavigationViewItem Content="启动管理" Tag="launch"><NavigationViewItem.Icon><FontIcon Glyph="&#xE768;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems>
    <NavigationViewItem Content="设置" Tag="settings" Icon="Setting"/>
    <NavigationViewItem Content="关于" Tag="about"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.FooterMenuItems>
   <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </NavigationView>
 </Grid>
</Window>
