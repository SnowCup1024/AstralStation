<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>AstralStation.Monitor</AssemblyName>
    <Version>1.0.0-alpha.100</Version>
    <DefineConstants>$(DefineConstants);STEAM_TEST</DefineConstants>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>../App/Assets/App.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Monitoring/*.cs" Link="Monitoring/%(Filename)%(Extension)" />
    <Compile Include="../App/SteamLaunch.cs" Link="SteamLaunch.cs" />
  </ItemGroup>
</Project>
